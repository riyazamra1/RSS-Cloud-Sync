<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RSSCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/dark_card</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_card</item>
        <item name="materialCardViewStyle">@style/RSSCardStyle</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

</resources>