            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="You are responsible for the files you synchronize and for keeping appropriate backups of important data. Sync operations can create, replace, move or delete files depending on the selected sync method and settings. Review your configuration before enabling automatic or delete-after-sync operations." android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:lineSpacingExtra="3dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="3. Cloud services" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Cloud storage is provided by third-party services. Their availability, limits, policies and account requirements are outside the control of RSS CLOUD SYNC. You remain responsible for your cloud accounts and compliance with the applicable provider terms." android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:lineSpacingExtra="3dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="4. Premium features" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Pro and Premium features may require a paid purchase or subscription through the applicable distribution platform. Features and pricing may change as the app evolves. Previously available features may be modified, replaced or discontinued when necessary." android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:lineSpacingExtra="3dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="5. Reliability and availability" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="The app is designed for reliable and efficient synchronization, but uninterrupted operation cannot be guaranteed. Device storage, Android restrictions, network conditions, cloud service availability, permissions, battery optimization and other factors can affect synchronization." android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:lineSpacingExtra="3dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="6. Updates" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="RSS CLOUD SYNC may receive updates, bug fixes, security improvements and feature changes. Keeping the app updated is recommended for the best available compatibility and performance." android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:lineSpacingExtra="3dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="7. Contact" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" />
