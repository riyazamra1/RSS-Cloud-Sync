            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Developer: Razeen Secure Solution" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
        </LinearLayout>
