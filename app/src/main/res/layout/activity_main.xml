<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FC"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#F7F7FC"
            android:elevation="0dp"
            app:title="RSS CLOUD SYNC"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="#15172A" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/premiumBanner"
            android:layout_width="match_parent"
            android:layout_height="146dp"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="#5B22D9"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:id="@+id/bannerLogo"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/rss_cloud_sync_logo" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your data, always safe with you" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Backup • Sync • Access • Anywhere" android:textColor="#E9E1FF" android:textSize="11sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="✓\nSecure" android:textColor="#FFFFFF" android:textSize="10sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="⟳\nReliable" android:textColor="#FFFFFF" android:textSize="10sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ϟ\nFast" android:textColor="#FFFFFF" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="12dp" android:gravity="center" android:orientation="horizontal">
            <View android:layout_width="28dp" android:layout_height="4dp" android:layout_marginEnd="5dp" android:background="@drawable/bg_indicator_active" />
            <View android:layout_width="7dp" android:layout_height="4dp" android:layout_marginEnd="5dp" android:background="@drawable/bg_indicator_inactive" />
            <View android:layout_width="7dp" android:layout_height="4dp" android:layout_marginEnd="5dp" android:background="@drawable/bg_indicator_inactive" />
            <View android:layout_width="7dp" android:layout_height="4dp" android:background="@drawable/bg_indicator_inactive" />
        </LinearLayout>

        <TextView android:id="@+id/appearanceTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="APPEARANCE" android:textColor="#15172A" android:textSize="14sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/appearanceCard" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:background="@drawable/bg_appearance_selector" android:gravity="center" android:orientation="horizontal" android:padding="3dp">
            <TextView android:id="@+id/lightButton" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="☀  Light" android:textColor="#25283A" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/systemButton" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="⚙  System" android:textColor="#25283A" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/darkButton" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="◐  Dark" android:textColor="#25283A" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/syncStatusHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="SYNC STATUS" android:textColor="#15172A" android:textSize="14sp" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/syncStatusCard" android:layout_width="match_parent" android:layout_height="214dp" android:layout_marginTop="6dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="3dp" app:strokeColor="#E6E6EF" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="130dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <com.riyaz.rsscloudsync.GradientProgressView android:id="@+id/gradientProgress" android:layout_width="112dp" android:layout_height="112dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="8dp" android:layout_height="8dp" android:text="●" android:textColor="#36C88B" android:textSize="10sp" />
                            <TextView android:id="@+id/syncStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Ready to sync" android:textColor="#15172A" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:id="@+id/syncSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Everything is up to date" android:textColor="#73788A" android:textSize="11sp" />
                        <TextView android:id="@+id/lastSyncText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Last sync: Never" android:textColor="#73788A" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/syncNowButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_gradient_button" android:insetTop="0dp" android:insetBottom="0dp" android:text="⟳   SYNC NOW" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" app:backgroundTint="@null" app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cloudStorageTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CLOUD ACCOUNTS" android:textColor="#15172A" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/cloudManageText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="Manage  ›" android:textColor="#6F63E8" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/cloudStorageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Connect your cloud accounts" android:textColor="#73788A" android:textSize="11sp" />

        <LinearLayout android:id="@+id/cloudProviderRow" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="7dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/googleDriveCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeColor="#E6E6EF" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="10dp">
                    <ImageView android:id="@+id/googleDriveIcon" android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="Google Drive" android:src="@drawable/ic_google_drive" />
                    <TextView android:id="@+id/googleDriveTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Google Drive" android:textColor="#15172A" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/googleDriveStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Not connected" android:textColor="#73788A" android:textSize="9sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/googleDriveConnectButton" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="5dp" android:text="CONNECT" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/oneDriveCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeColor="#E6E6EF" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="10dp">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="OneDrive" android:src="@drawable/ic_onedrive" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="OneDrive" android:textColor="#15172A" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Not connected" android:textColor="#73788A" android:textSize="9sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/oneDriveConnectButton" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="5dp" android:text="CONNECT" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/dropboxCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeColor="#E6E6EF" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="10dp">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="Dropbox" android:src="@drawable/ic_dropbox" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Dropbox" android:textColor="#15172A" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Not connected" android:textColor="#73788A" android:textSize="9sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/dropboxConnectButton" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="5dp" android:text="CONNECT" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SYNC TOOLS" android:textColor="#15172A" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:id="@+id/foldersCard" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="7dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="15dp" app:cardElevation="2dp" app:strokeColor="#E6E6EF" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="📁" android:textSize="22sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sync folders" android:textColor="#15172A" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose your local sync folder" android:textColor="#73788A" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#73788A" android:textSize="24sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/syncSetupCard" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="15dp" app:cardElevation="2dp" app:strokeColor="#E6E6EF" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="⚙" android:textColor="#6F63E8" android:textSize="22sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Automatic sync" android:textColor="#15172A" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Schedule and sync direction" android:textColor="#73788A" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#73788A" android:textSize="24sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>