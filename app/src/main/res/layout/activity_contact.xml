<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@android:color/transparent" app:titleTextColor="?attr/colorOnSurface" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="36dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Get in touch" android:textColor="?attr/colorOnSurface" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Need help with RSS CLOUD SYNC? Contact the developer for support, problem reports or feature suggestions." android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:lineSpacingExtra="3dp" />

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" app:cardBackgroundColor="?attr/colorSurfaceContainer" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Razeen Secure Solution" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Developer of RSS CLOUD SYNC" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="rsscctvsolution@gmail.com" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/emailSupportCard" android:layout_width="match_parent" android:layout_height="78dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurfaceContainer" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="✉" android:textColor="#7547E8" android:textSize="24sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email support" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="General help and support" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="25sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/reportProblemCard" android:layout_width="match_parent" android:layout_height="78dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurfaceContainer" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="!" android:textColor="#D64D80" android:textSize="24sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Report a problem" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Tell us what went wrong" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="25sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/featureRequestCard" android:layout_width="match_parent" android:layout_height="78dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurfaceContainer" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="+" android:textColor="#4A82F5" android:textSize="26sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feature request" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Suggest an improvement" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="25sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
