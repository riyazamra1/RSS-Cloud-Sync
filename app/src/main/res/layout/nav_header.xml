<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="196dp"
    android:orientation="vertical"
    android:gravity="bottom"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:background="@drawable/bg_drawer_header">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/rss_cloud_sync_logo"
        android:scaleType="fitCenter"
        android:contentDescription="RSS CLOUD SYNC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="RSS CLOUD SYNC"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:letterSpacing="0.02"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="One place for all your clouds"
        android:textColor="#E7E2FF"
        android:textSize="11sp" />
</LinearLayout>
