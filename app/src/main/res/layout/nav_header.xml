<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_drawer_header">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
        <FrameLayout android:layout_width="78dp" android:layout_height="78dp" android:background="@drawable/bg_drawer_logo" android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/rss_cloud_sync_logo" android:scaleType="fitCenter" android:contentDescription="RSS CLOUD SYNC" />
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="RSS CLOUD SYNC" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.035" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Backup • Sync • Access • Anywhere" android:textColor="#D5E4FF" android:textSize="9sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_drawer_status">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You are using" android:textColor="#8EA2C4" android:textSize="8sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FREE PLAN" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="30dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="UPGRADE" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/bg_gradient_button" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Upgrade to Premium for unlimited features" android:textColor="#B9C8E0" android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>
