<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="172dp"
    android:orientation="vertical"
    android:gravity="bottom"
    android:padding="22dp"
    android:background="@drawable/bg_drawer_header">

    <ImageView
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:src="@drawable/rss_cloud_sync_logo"
        android:scaleType="fitCenter"
        android:contentDescription="RSS CLOUD SYNC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="RSS CLOUD SYNC"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:letterSpacing="0.04"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Your clouds. One secure space."
        android:textColor="#AEBBD0"
        android:textSize="11sp" />
</LinearLayout>
