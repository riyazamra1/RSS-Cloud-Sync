<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="150dp" android:orientation="vertical"
    android:padding="10dp" android:background="@drawable/bg_drawer_header">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <FrameLayout android:layout_width="82dp" android:layout_height="82dp" android:background="@drawable/bg_drawer_logo" android:padding="4dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/rss_cloud_sync_logo" android:scaleType="fitCenter" android:contentDescription="RSS CLOUD SYNC" />
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="RSS CLOUD SYNC" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Backup • Sync • Access • Anywhere" android:textColor="#D5E4FF" android:textSize="7sp" />
    </LinearLayout>
</LinearLayout>
